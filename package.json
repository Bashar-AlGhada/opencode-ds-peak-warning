{
  "name": "ds-peak-warningx",
  "version": "1.3.1",
  "description": "DeepSeek peak/off-peak pricing warning in the opencode TUI sidebar",
  "keywords": [
    "opencode",
    "tui",
    "plugin",
    "deepseek",
    "pricing"
  ],
  "license": "MIT",
  "author": "Bashar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bashar-AlGhada/opencode-ds-peak-warning.git"
  },
  "homepage": "https://github.com/Bashar-AlGhada/opencode-ds-peak-warning",
  "bugs": {
    "url": "https://github.com/Bashar-AlGhada/opencode-ds-peak-warning/issues"
  },
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "sanity": "node --experimental-strip-types scripts/sanity-check.mjs",
    "live": "bun scripts/live-src-test.ts",
    "prepublishOnly": "npm run build && npm run sanity",
    "pack": "npm pack --dry-run"
  },
  "dependencies": {
    "@opentui/core": "^0.5.4",
    "@opentui/solid": "^0.5.4",
    "solid-js": "^1.9.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.18",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0"
  }
}
