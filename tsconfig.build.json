{
  // Emit config for the published artifact. The packaged opencode CLI does not
  // reliably apply the Solid transform to external TSX, so ./tui must resolve
  // to PRECOMPILED JS: tsc compiles the JSX via @opentui/solid's jsx-runtime
  // (./dist/*.js + *.d.ts). Under an npm install the host maps bare solid-js
  // and @opentui/* imports to its singletons (one reactive graph, live UI);
  // local file installs keep project-local copies (see CHANGELOG 1.3.1).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
